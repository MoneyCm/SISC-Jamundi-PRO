DATABASE_URL=postgresql://sisc_user:sisc_password@127.0.0.1:5432/sisc_jamundi
PORT=8000
ENVIRONMENT=development
SECRET_KEY=replace_with_random_value_of_at_least_32_characters
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SISC_REPORT_TRIGGER_KEY=replace_with_different_random_service_key
SISC_SOURCE_MONITOR_KEY=replace_with_another_random_service_key

# Umbral minimo de hechos por territorio para pintar en el mapa.
SISC_PUBLIC_MIN_LOCATION_COUNT=3

# GeoJSON adicional (separado por coma)
# SISC_EXTRA_GEOJSON_PATHS=C:/Proyectos/SISC-Jamundi-PRO/backend/data/barrios_jamundi_valle_extra.geojson
